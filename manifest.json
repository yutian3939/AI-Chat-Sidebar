{
  "manifest_version": 3,
  "name": "AI Chat Sidebar",
  "version": "1.1.0",
  "description": "MD3 风格的 AI 对话侧边栏，支持 OpenAI 兼容格式",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["<all_urls>", "https://lite.duckduckgo.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/katex.min.js",
        "content/styles.js",
        "content/icons.js",
        "content/markdown.js",
        "content/auto-answer.js",
        "content/settings-panel.js",
        "content/screenshot.js",
        "content/template.js",
        "content/history-panel.js",
        "content/index.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
